# Pasta do motor de edição (padrão: ../primeiro-corte)
MOTOR_DIR=../primeiro-corte
# Python usado para rodar o motor
PYTHON=python3
# Onde ficam banco e arquivos enviados (padrão: ./dados)
DADOS_DIR=./dados
# Endereço público do app, usado para montar os links enviados ao cliente
APP_URL=http://localhost:3000
# Opcional: liga a extração de estilo com modelo de visão
ANTHROPIC_API_KEY=
